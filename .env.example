# ============================================================
# 版本发布系统 v2 · 环境变量示例
# 复制为 .env 并按需修改；所有密钥必须自行生成，切勿使用示例值。
# 生成密钥示例: openssl rand -hex 32
# ============================================================

# ---------- 服务 ----------
APPV_SERVER_PORT=9080
APPV_SERVER_MODE=debug          # debug | release
APPV_SERVER_BASE_URL=http://localhost:9080
# 反向代理信任列表：只有来自这些地址的 X-Forwarded-For 会被采信，
# 避免伪造来源绕过 IP 限流。取值：IP/CIDR 逗号分隔 | none | *
APPV_SERVER_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- 数据库 (sqlite | postgres | mysql) ----------
APPV_DATABASE_DRIVER=sqlite
# sqlite 专用：数据库文件路径
APPV_DATABASE_PATH=./data/app_version.db
# postgres / mysql 专用：完整 DSN（设置后覆盖 driver 的默认连接方式）
# postgres: host=127.0.0.1 user=appv password=*** dbname=appv port=5432 sslmode=disable TimeZone=Asia/Shanghai
# mysql:    appv:***@tcp(127.0.0.1:3306)/appv?charset=utf8mb4&parseTime=True&loc=Local
APPV_DATABASE_DSN=
# 启动时自动补齐表结构；false 适合由 DBA 预建表或只读副本（需先跑 -migrate-only）
APPV_DATABASE_AUTO_MIGRATE=true

# ---------- 安全（生产必填，缺失将拒绝启动） ----------
APPV_JWT_SECRET=
APPV_DOWNLOAD_TOKEN_KEY=
APPV_SHARE_PASSWORD_PEPPER=
# 首次启动时创建管理员账号所用的初始密码（仅首次生效，登录后请立即修改）
APPV_ADMIN_INITIAL_PASSWORD=
APPV_ADMIN_USERNAME=admin
# JWT access / refresh 有效期（小时 / 天）
APPV_JWT_EXPIRE_HOURS=24
APPV_JWT_REFRESH_DAYS=7

# ---------- 存储 (local | s3) ----------
APPV_STORAGE_DRIVER=local
# local
APPV_STORAGE_LOCAL_ROOT=./static/uploads
# s3 / minio（driver=s3 时必填）
APPV_STORAGE_S3_ENDPOINT=
APPV_STORAGE_S3_REGION=us-east-1
APPV_STORAGE_S3_BUCKET=
APPV_STORAGE_S3_ACCESS_KEY=
APPV_STORAGE_S3_SECRET_KEY=
APPV_STORAGE_S3_USE_SSL=false
# MinIO 等自建服务通常需要 true
APPV_STORAGE_S3_FORCE_PATH_STYLE=true
# 预签名下载 URL 有效期（分钟）
APPV_STORAGE_SIGNED_URL_TTL_MINUTES=30

# ---------- 其他 ----------
APPV_LOG_LEVEL=info             # debug | info | warn | error
APPV_UPLOAD_MAX_SIZE_MB=4096
APPV_CORS_ALLOWED_ORIGINS=
