# Git
.git
.gitignore

# 前端
frontend/node_modules
frontend/dist
frontend/.vscode
frontend/npm-debug.log
frontend/*.log

# 后端
backend/data/*.db
backend/static/uploads/*
backend/.vscode

# 部署目录
deploy/www/
deploy/app
deploy/appv

# 文档、脚本与备份
docs/
scripts/
backups/

# 环境文件（避免把密钥打进镜像）
.env
.env.*

# 真实配置文件（含数据库连接串与密钥），镜像内只使用 config.example.yaml 模板
backend/config.yaml
deploy/config.yaml

# IDE 配置
.vscode/
.idea/

# 其他
*.exe
*.log
*.swp
