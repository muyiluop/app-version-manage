# Git
.git
.gitignore

# 前端
frontend/node_modules
frontend/dist
frontend/.vscode
frontend/npm-debug.log
frontend/*.log

# 后端
backend/data/*.db
backend/static/uploads/*
backend/.vscode

# 部署目录
deploy/www/
deploy/app
deploy/appv

# 文档、脚本与备份
docs/
scripts/
backups/

# 环境文件（避免把密钥打进镜像）
.env
.env.*

# IDE 配置
.vscode/
.idea/

# 其他
*.exe
*.log
*.swp
